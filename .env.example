# Copy to .env and fill in. .env is git-ignored; never commit it and never paste keys into chat.
# Agent identity for the multi-agent protocol (see CLAUDE.md)
AGENT_ID=cc-yourname
# NASS Quick Stats API key: free, by email form at https://quickstats.nass.usda.gov/api
NASS_QUICKSTATS_API_KEY=
# Google Earth Engine: the Cloud project id registered for Earth Engine (then run `earthengine authenticate` once)
EE_PROJECT=
# NVIDIA API key for hosted Nemotron (starts with nvapi-): https://build.nvidia.com
NVIDIA_API_KEY=
# Optional: OpenRouter key as a second Nemotron route
OPENROUTER_API_KEY=
# Optional: Hugging Face token, needed to download Nemotron weights for fine-tuning
HF_TOKEN=
# Optional: NASA Earthdata login, only for EMIT and direct HLS downloads
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
