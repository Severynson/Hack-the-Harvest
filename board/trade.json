"facts": [
{
"text": "2024/25 was a record year for US corn exports: 72.5 million metric tons (2.855 billion bushels), worth more than $16.35 billion.",
"src": "US Grains Council, 2025 annual report",
"url": "https://grains.org/2025-annual-report/panels/u-s-corn-exports-up-nearly-27-percent-breaking-record/"
},
{
"text": "Mexico was the top buyer at more than 25.5 million tons, 35% of all US corn exports.",
"src": "US Grains Council, 2025 annual report",
"url": "https://grains.org/2025-annual-report/panels/u-s-corn-exports-up-nearly-27-percent-breaking-record/"
},
{
"text": "The top three markets were Mexico, Japan and Colombia.",
"src": "Illinois Corn, Dec 17 2025",
"url": "https://www.ilcorn.org/new-data-details-current-u-s-corn-export-volumes"
},
{
"text": "In 2025, about 51% of US grain export shipments left through the Gulf, 28% through the Pacific Northwest and 21% through other regions.",
"src": "USDA AMS Grain Transportation Report, Feb 26 2026",
"url": "https://ams-prod.azureedge.us/sites/default/files/media/GTR02262026.pdf"
},
{
"text": "Shipping a ton of grain to Japan cost $56.00 from the Gulf but $29.50 from the Pacific Northwest (week of Dec 18 2025).",
"src": "USDA AMS Grain Transportation Report, Dec 18 2025",
"url": "https://ams-prod.azureedge.us/sites/default/files/media/GTR12182025.pdf"
}
]
}